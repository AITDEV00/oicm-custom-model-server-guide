+def _patch_vllm_attention_context_aliases() -> None:
+    try:
+        from vllm.model_executor.layers.attention import attention as attention_module
+    except Exception:
+        return
+
+    if getattr(attention_module, "_vibevoice_attention_alias_patch", False):
+        return
+
+    original_get_attention_context = attention_module.get_attention_context
+
+    def _resolve_layer_name(forward_context, layer_name: str) -> str:
+        if layer_name in forward_context.no_compile_layers:
+            return layer_name
+
+        candidates = []
+        if layer_name.startswith("model."):
+            candidates.append(f"language_model.{layer_name}")
+        if layer_name.startswith("language_model.model."):
+            candidates.append(layer_name.removeprefix("language_model."))
+        if layer_name.startswith("language_model."):
+            candidates.append(layer_name.removeprefix("language_model."))
+
+        for candidate in candidates:
+            if candidate in forward_context.no_compile_layers:
+                return candidate
+
+        raise KeyError(layer_name)
+
+    def _wrapped_get_attention_context(layer_name: str):
+        try:
+            return original_get_attention_context(layer_name)
+        except KeyError:
+            forward_context = attention_module.get_forward_context()
+            resolved_layer_name = _resolve_layer_name(forward_context, layer_name)
+            attn_metadata = forward_context.attn_metadata
+            if isinstance(attn_metadata, dict):
+                attn_metadata = attn_metadata[resolved_layer_name]
+            attn_layer = forward_context.no_compile_layers[resolved_layer_name]
+            kv_cache = getattr(attn_layer, "kv_cache", None)
+            if isinstance(kv_cache, (list, tuple)):
+                ve = getattr(forward_context, "virtual_engine", 0)
+                kv_cache = kv_cache[ve] if ve < len(kv_cache) else kv_cache[0]
+            layer_slot_mapping = forward_context.slot_mapping.get(resolved_layer_name)
+            return attn_metadata, attn_layer, kv_cache, layer_slot_mapping
+
+    attention_module.get_attention_context = _wrapped_get_attention_context
+    attention_module._vibevoice_attention_alias_patch = True
+
+
+_patch_vllm_attention_context_aliases()
+
