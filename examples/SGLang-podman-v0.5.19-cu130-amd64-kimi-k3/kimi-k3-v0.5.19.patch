+    def _budget_in_group(self, own_reading, peer_readings, ranks=8):
+        # The reduce stands in for the gloo collective: every rank of the
+        # sync group contributes its own psutil reading and all of them get
+        # the minimum back.
+        fake_group = object()
+        seen = {}
